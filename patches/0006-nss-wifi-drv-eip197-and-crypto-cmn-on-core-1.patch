--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_crypto.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* EIP-197 hardware crypto engine and Core 1 nss_crypto_cmn interface. */
+
+#ifndef __NSS_CRYPTO_H
+#define __NSS_CRYPTO_H
+
+#include <linux/seq_file.h>
+#include <linux/types.h>
+
+struct nss_core;
+struct nss_cmn_msg;
+
+#define NSS_CRYPTO_MAX_CTX		64
+#define NSS_CRYPTO_CIPHER_KEYLEN_MAX	32
+#define NSS_CRYPTO_AUTH_KEYLEN_MAX	128
+#define NSS_CRYPTO_NONCE_SIZE_MAX	4
+
+/* Wire values matching firmware enum nss_crypto_cmn_algo. */
+enum nss_crypto_algo {
+	NSS_CRYPTO_ALGO_AES128_GCM_GMAC		= 29,
+	NSS_CRYPTO_ALGO_AES128_CBC_MD5_HMAC	= 30,
+	NSS_CRYPTO_ALGO_AES128_CBC_SHA160_HMAC	= 31,
+	NSS_CRYPTO_ALGO_AES128_CBC_SHA256_HMAC	= 32,
+	NSS_CRYPTO_ALGO_AES128_CBC_SHA384_HMAC	= 33,
+	NSS_CRYPTO_ALGO_AES128_CBC_SHA512_HMAC	= 34,
+	NSS_CRYPTO_ALGO_AES192_GCM_GMAC		= 35,
+	NSS_CRYPTO_ALGO_AES192_CBC_SHA160_HMAC	= 37,
+	NSS_CRYPTO_ALGO_AES192_CBC_SHA256_HMAC	= 38,
+	NSS_CRYPTO_ALGO_AES192_CBC_SHA384_HMAC	= 39,
+	NSS_CRYPTO_ALGO_AES192_CBC_SHA512_HMAC	= 40,
+	NSS_CRYPTO_ALGO_AES256_GCM_GMAC		= 41,
+	NSS_CRYPTO_ALGO_AES256_CBC_MD5_HMAC	= 42,
+	NSS_CRYPTO_ALGO_AES256_CBC_SHA160_HMAC	= 43,
+	NSS_CRYPTO_ALGO_AES256_CBC_SHA256_HMAC	= 44,
+	NSS_CRYPTO_ALGO_AES256_CBC_SHA384_HMAC	= 45,
+	NSS_CRYPTO_ALGO_AES256_CBC_SHA512_HMAC	= 46,
+	NSS_CRYPTO_ALGO_3DES_CBC_SHA160_HMAC	= 66,
+	NSS_CRYPTO_ALGO_3DES_CBC_SHA256_HMAC	= 67,
+};
+
+struct nss_crypto_ctx_cfg {
+	enum nss_crypto_algo algo;
+	const u8 *cipher_key;
+	u16 cipher_keylen;
+	const u8 *auth_key;
+	u16 auth_keylen;
+	const u8 *nonce;
+	u16 nonce_len;
+};
+
+int nss_crypto_start(struct nss_core *core);
+void nss_crypto_stop(struct nss_core *core);
+bool nss_crypto_ready(void);
+int nss_crypto_ctx_alloc(const struct nss_crypto_ctx_cfg *cfg, u16 *idx_out);
+void nss_crypto_ctx_free(u16 idx);
+void nss_crypto_notify(struct nss_core *core, const struct nss_cmn_msg *ncm,
+		       u32 len);
+void nss_crypto_print(struct seq_file *s);
+
+#endif /* __NSS_CRYPTO_H */
