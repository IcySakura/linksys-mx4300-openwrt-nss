diff --git a/target/linux/qualcommax/patches-6.18/9900-clk-qcom-ipq8074-run-the-CPU-from-GPLL2-above-the-APSS-PLL-limit.patch b/target/linux/qualcommax/patches-6.18/9900-clk-qcom-ipq8074-run-the-CPU-from-GPLL2-above-the-APSS-PLL-limit.patch
new file mode 100644
index 0000000000..a9f9c8a35d
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.18/9900-clk-qcom-ipq8074-run-the-CPU-from-GPLL2-above-the-APSS-PLL-limit.patch
@@ -0,0 +1,187 @@
+From: Myles Liu <lyx981mike@gmail.com>
+Subject: clk: qcom: ipq8074: run the CPU from GPLL2 above the APSS PLL's limit
+
+The 1.4 GHz IPQ807x bins (IPQ8174 and the like) have an APSS Huayra PLL
+that holds its multiplier at 73: whatever L is programmed above that, the
+PLL runs at 73 x 19.2 = 1401.6 MHz (its debug status, TEST_CTL[7:6] = 3,
+reads back L = 73, and the A53 cycle counter agrees). The clamp is inside
+the PLL; neither voltage nor any APSS register changes it.
+
+GCC's GPLL2, otherwise only an SDCC clock source, reaches the APSS mux as
+source 2 and has no such limit: the cores run at exactly the GPLL2 rate,
+2208 MHz included.
+
+When the device tree names a "gpll2" clock for the APCS block:
+- rates above 1401.6 MHz are taken from GPLL2, all others from the APSS
+  PLL as before;
+- the cores are parked on GPLL0 during every rate change (the notifier
+  IPQ53xx already uses), and return to whichever PLL the clock framework
+  chose;
+- GPLL2 changes rate through the alpha PLL update latch.
+
+Boards that do not name "gpll2" are unaffected.
+
+Signed-off-by: Myles Liu <lyx981mike@gmail.com>
+--- a/drivers/clk/qcom/apss-ipq6018.c	2026-11-15 19:29:31.873491576 -0800
++++ b/drivers/clk/qcom/apss-ipq6018.c	2026-11-15 19:29:55.703701033 -0800
+@@ -10,6 +10,7 @@
+ #include <linux/regmap.h>
+ #include <linux/module.h>
+ #include <linux/clk.h>
++#include <linux/of.h>
+ #include <linux/soc/qcom/smem.h>
+ 
+ #include <dt-bindings/clock/qcom,apss-ipq.h>
+@@ -25,18 +26,21 @@
+ 	P_XO,
+ 	P_GPLL0,
+ 	P_APSS_PLL_EARLY,
++	P_GPLL2,
+ };
+ 
+ static const struct clk_parent_data parents_apcs_alias0_clk_src[] = {
+ 	{ .fw_name = "xo" },
+ 	{ .fw_name = "gpll0" },
+ 	{ .fw_name = "pll" },
++	{ .fw_name = "gpll2" },
+ };
+ 
+ static const struct parent_map parents_apcs_alias0_clk_src_map[] = {
+ 	{ P_XO, 0 },
+ 	{ P_GPLL0, 4 },
+ 	{ P_APSS_PLL_EARLY, 5 },
++	{ P_GPLL2, 2 },
+ };
+ 
+ static struct clk_rcg2 apcs_alias0_clk_src = {
+@@ -87,21 +91,63 @@
+ 	.num_clks = ARRAY_SIZE(apss_ipq6018_clks),
+ };
+ 
++/*
++ * The 1.4 GHz IPQ807x bins (IPQ8174 and the like) have an APSS PLL that never
++ * runs faster than 73 x 19.2 = 1401.6 MHz, whatever L is programmed: the
++ * clamp is inside the PLL. GCC's GPLL2, normally only an SDCC clock source,
++ * reaches this mux as source 2 and has no such limit. When the device tree
++ * hands GPLL2 in (clock-names "gpll2"), rates above the APSS PLL's limit are
++ * taken from GPLL2 and everything else from the APSS PLL as before.
++ */
++#define APSS_PLL_MAX_RATE	1401600000UL
++
++static bool apss_gpll2_boost;
++static struct clk_ops apcs_alias0_boost_ops;
++
++static int apcs_alias0_boost_determine_rate(struct clk_hw *hw,
++					    struct clk_rate_request *req)
++{
++	struct clk_rate_request parent_req;
++	struct clk_hw *parent;
++	int ret;
++
++	parent = clk_hw_get_parent_by_index(hw, req->rate > APSS_PLL_MAX_RATE ?
++					    P_GPLL2 : P_APSS_PLL_EARLY);
++	if (!parent)
++		return -EINVAL;
++
++	clk_hw_forward_rate_request(hw, req, parent, &parent_req, req->rate);
++	ret = __clk_determine_rate(parent, &parent_req);
++	if (ret)
++		return ret;
++
++	req->best_parent_hw = parent;
++	req->best_parent_rate = parent_req.rate;
++	req->rate = parent_req.rate;
++
++	return 0;
++}
++
+ static int cpu_clk_notifier_fn(struct notifier_block *nb, unsigned long action,
+ 				void *data)
+ {
+-	struct clk_hw *hw;
++	struct clk_hw *hw = &apcs_alias0_clk_src.clkr.hw;
+ 	u8 index;
+ 	int err;
+ 
++	/*
++	 * Run from GPLL0 while a PLL changes rate; afterwards return to the
++	 * parent the clock framework has chosen (the APSS PLL, or GPLL2 for
++	 * a boost rate).
++	 */
+ 	if (action == PRE_RATE_CHANGE)
+ 		index = P_GPLL0;
+ 	else if (action == POST_RATE_CHANGE || action == ABORT_RATE_CHANGE)
+-		index = P_APSS_PLL_EARLY;
++		index = apss_gpll2_boost ? clk_hw_get_parent_index(hw) :
++					   P_APSS_PLL_EARLY;
+ 	else
+ 		return NOTIFY_OK;
+ 
+-	hw = &apcs_alias0_clk_src.clkr.hw;
+ 	err = clk_rcg2_mux_closest_ops.set_parent(hw, index);
+ 
+ 	return notifier_from_errno(err);
+@@ -111,7 +157,9 @@
+ {
+ 	struct clk_hw *hw = &apcs_alias0_clk_src.clkr.hw;
+ 	struct notifier_block *cpu_clk_notifier;
++	struct device_node *np;
+ 	struct regmap *regmap;
++	bool scaling = false;
+ 	u32 soc_id;
+ 	int ret;
+ 
+@@ -123,6 +171,17 @@
+ 	if (!regmap)
+ 		return -ENODEV;
+ 
++	np = pdev->dev.of_node ?: pdev->dev.parent->of_node;
++	if (np && of_property_match_string(np, "clock-names", "gpll2") >= 0) {
++		apss_gpll2_boost = true;
++		apcs_alias0_boost_ops = clk_rcg2_mux_closest_ops;
++		apcs_alias0_boost_ops.determine_rate = apcs_alias0_boost_determine_rate;
++		((struct clk_init_data *)apcs_alias0_clk_src.clkr.hw.init)->ops =
++			&apcs_alias0_boost_ops;
++		dev_info(&pdev->dev, "CPU rates above %lu Hz from GPLL2\n",
++			 APSS_PLL_MAX_RATE);
++	}
++
+ 	ret = qcom_cc_really_probe(&pdev->dev, &apss_ipq6018_desc, regmap);
+ 	if (ret)
+ 		return ret;
+@@ -132,6 +191,14 @@
+ 	case QCOM_ID_IPQ5332:
+ 	case QCOM_ID_IPQ5322:
+ 	case QCOM_ID_IPQ5300:
++		scaling = true;
++		break;
++	default:
++		scaling = apss_gpll2_boost;
++		break;
++	}
++
++	if (scaling) {
+ 		cpu_clk_notifier = devm_kzalloc(&pdev->dev,
+ 						sizeof(*cpu_clk_notifier),
+ 						GFP_KERNEL);
+@@ -143,9 +210,6 @@
+ 		ret = devm_clk_notifier_register(&pdev->dev, hw->clk, cpu_clk_notifier);
+ 		if (ret)
+ 			return ret;
+-		break;
+-	default:
+-		break;
+ 	}
+ 
+ 	return 0;
+--- a/drivers/clk/qcom/gcc-ipq8074.c	2026-11-15 19:29:31.873491576 -0800
++++ b/drivers/clk/qcom/gcc-ipq8074.c	2026-11-15 19:29:55.703701033 -0800
+@@ -94,6 +94,8 @@
+ static struct clk_alpha_pll gpll2_main = {
+ 	.offset = 0x4a000,
+ 	.regs = clk_alpha_pll_regs[CLK_ALPHA_PLL_TYPE_DEFAULT],
++	/* Also a CPU clock source (apss-ipq6018.c): latch rate changes. */
++	.flags = SUPPORTS_DYNAMIC_UPDATE,
+ 	.clkr = {
+ 		.enable_reg = 0x0b000,
+ 		.enable_mask = BIT(2),
diff --git a/target/linux/qualcommax/patches-6.18/9901-cpufreq-let-schedutil-reach-boost-frequencies.patch b/target/linux/qualcommax/patches-6.18/9901-cpufreq-let-schedutil-reach-boost-frequencies.patch
new file mode 100644
index 0000000000..f99064e238
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.18/9901-cpufreq-let-schedutil-reach-boost-frequencies.patch
@@ -0,0 +1,71 @@
+From: Myles Liu <lyx981mike@gmail.com>
+Subject: cpufreq: boost: let schedutil reach boost frequencies, leave the
+ limit to userspace
+
+schedutil maps full utilization to the CPUs' reference frequency, which
+arch_topology (init_cpu_capacity_callback) takes from cpuinfo.max_freq
+once, when the cpufreq policy is created. With boost off at that moment the
+reference stays at the highest non-boost frequency, and enabling boost
+later makes the boost frequencies selectable by hand but never by
+schedutil: a fully busy CPU still asks for the old maximum. When software
+boost changes cpuinfo.max_freq, move the reference along, for the CPUs
+whose reference was taken from it.
+
+Enabling boost also no longer raises the policy limit to the top boost
+frequency: on the MX4300 the top boost frequencies need a raised voltage,
+so userspace raises scaling_max_freq itself, after setting the voltage.
+Disabling boost still lowers the limit.
+
+Signed-off-by: Myles Liu <lyx981mike@gmail.com>
+
+--- a/drivers/cpufreq/cpufreq.c	2026-11-15 19:56:46.466996596 -0800
++++ b/drivers/cpufreq/cpufreq.c	2026-11-15 21:13:06.380283371 -0800
+@@ -14,6 +14,7 @@
+ 
+ #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+ 
++#include <linux/arch_topology.h>
+ #include <linux/cpu.h>
+ #include <linux/cpufreq.h>
+ #include <linux/cpu_cooling.h>
+@@ -2782,6 +2783,8 @@
+  *********************************************************************/
+ int cpufreq_boost_set_sw(struct cpufreq_policy *policy, int state)
+ {
++	unsigned int old_max = policy->cpuinfo.max_freq;
++	unsigned int old_limit = policy->max;
+ 	int ret;
+ 
+ 	if (!policy->freq_table)
+@@ -2793,6 +2796,31 @@
+ 		return ret;
+ 	}
+ 
++#ifdef CONFIG_GENERIC_ARCH_TOPOLOGY
++	/*
++	 * schedutil maps full utilization to the CPUs' reference frequency,
++	 * which arch_topology takes from cpuinfo.max_freq once, when the policy
++	 * is created. Where it did, follow the boost state; otherwise the
++	 * boost frequencies stay out of schedutil's reach.
++	 */
++	{
++		int cpu;
++
++		for_each_cpu(cpu, policy->related_cpus)
++			if (per_cpu(capacity_freq_ref, cpu) == old_max)
++				per_cpu(capacity_freq_ref, cpu) =
++					policy->cpuinfo.max_freq;
++	}
++#endif
++
++	/*
++	 * Enabling boost makes the boost frequencies available without raising
++	 * the limit: userspace raises scaling_max_freq when it is ready for
++	 * them (e.g. after adjusting the voltage). Disabling boost still lowers
++	 * the limit to the highest non-boost frequency.
++	 */
++	if (state)
++		policy->max = min(old_limit, policy->max);
+ 	ret = freq_qos_update_request(policy->max_freq_req, policy->max);
+ 	if (ret < 0)
+ 		return ret;
diff --git a/target/linux/qualcommax/patches-6.18/9902-regulator-cpr3-runtime-voltage-offset-per-corner.patch b/target/linux/qualcommax/patches-6.18/9902-regulator-cpr3-runtime-voltage-offset-per-corner.patch
new file mode 100644
index 0000000000..86fe958be4
--- /dev/null
+++ b/target/linux/qualcommax/patches-6.18/9902-regulator-cpr3-runtime-voltage-offset-per-corner.patch
@@ -0,0 +1,138 @@
+From: Myles Liu <lyx981mike@gmail.com>
+Subject: regulator: cpr3: runtime voltage offset per corner
+
+Add a debugfs file, offset_volt, next to each corner's floor_volt,
+ceiling_volt and open_loop_volt (writable for the corner selected through
+corner/index). Writing an offset in microvolts shifts that corner's floor,
+ceiling, open-loop and last voltages by the change, and its target
+quotients by the matching amount (cpr3_quot_adjustment with the corner's
+RO scaling factors), then re-aggregates the controller state. Closed-loop
+CPR keeps adapting around the new point.
+
+The result must keep the corner between 592 and 1064 mV; offsets are
+limited to +-200 mV.
+
+Used by mx4300-cpu-oc for voltage tuning and for speeds above 2208 MHz.
+
+Signed-off-by: Myles Liu <lyx981mike@gmail.com>
+
+--- a/drivers/regulator/cpr3-regulator.h	2026-11-15 20:40:04.246348753 -0800
++++ b/drivers/regulator/cpr3-regulator.h	2026-11-15 20:40:33.796561695 -0800
+@@ -143,6 +143,10 @@
+  *			corner on CPRh controllers.
+  * @sdelta:		The CPR4 controller specific data for this corner. This
+  *			field is applicable for CPR4 controllers.
++ * @user_offset_volt:	Voltage offset in microvolts requested at runtime
++ *			through debugfs (offset_volt), already applied to the
++ *			floor, ceiling, open-loop and last voltages and to the
++ *			target quotients of this corner.
+  *
+  * The value of last_volt is initialized inside of the cpr3_regulator_register()
+  * call with the open_loop_volt value.  It can later be updated to the settled
+@@ -177,6 +181,7 @@
+ 	int			aging_derate;
+ 	bool			use_open_loop;
+ 	struct cpr4_sdelta	*sdelta;
++	int			user_offset_volt;
+ };
+ 
+ /**
+--- a/drivers/regulator/cpr3-regulator.c	2026-11-15 20:40:04.246348753 -0800
++++ b/drivers/regulator/cpr3-regulator.c	2026-11-15 22:08:41.102864510 -0800
+@@ -3744,6 +3744,78 @@
+ DEFINE_SIMPLE_ATTRIBUTE(cpr3_debug_corner_int_fops, cpr3_debug_corner_int_get,
+ 			NULL, "%lld\n");
+ 
++/*
++ * Runtime voltage offset for one corner (debugfs "offset_volt" next to the
++ * corner's index file). Shifts the corner's floor, ceiling, open-loop and
++ * last voltages by the change in offset and moves its target quotients by
++ * the matching amount, so closed-loop CPR keeps working around the new
++ * point. The result must stay inside the absolute limits below.
++ */
++#define CPR3_USER_OFFSET_LIMIT		200000
++#define CPR3_USER_VOLT_MIN		592000
++#define CPR3_USER_VOLT_MAX		1064000
++
++static int cpr3_debug_corner_offset_get(void *data, u64 *val)
++{
++	struct cpr3_debug_corner_info *info = data;
++	struct cpr3_controller *ctrl = info->vreg->thread->ctrl;
++	int i;
++
++	mutex_lock(&ctrl->lock);
++	i = max(*info->index, 0);
++	*val = (s64)info->vreg->corner[i].user_offset_volt;
++	mutex_unlock(&ctrl->lock);
++
++	return 0;
++}
++
++static int cpr3_debug_corner_offset_set(void *data, u64 val)
++{
++	struct cpr3_debug_corner_info *info = data;
++	struct cpr3_regulator *vreg = info->vreg;
++	struct cpr3_controller *ctrl = vreg->thread->ctrl;
++	struct cpr3_corner *corner;
++	int offset = (int)(s64)val;
++	int delta, i, rc;
++
++	if (offset < -CPR3_USER_OFFSET_LIMIT || offset > CPR3_USER_OFFSET_LIMIT)
++		return -EINVAL;
++
++	mutex_lock(&ctrl->lock);
++
++	corner = &vreg->corner[max(*info->index, 0)];
++	delta = offset - corner->user_offset_volt;
++	if (corner->floor_volt + delta < CPR3_USER_VOLT_MIN ||
++	    corner->ceiling_volt + delta > CPR3_USER_VOLT_MAX) {
++		mutex_unlock(&ctrl->lock);
++		return -ERANGE;
++	}
++
++	corner->floor_volt += delta;
++	corner->ceiling_volt += delta;
++	corner->open_loop_volt += delta;
++	corner->last_volt = clamp(corner->last_volt + delta,
++				  corner->floor_volt, corner->ceiling_volt);
++	for (i = 0; i < CPR3_RO_COUNT; i++)
++		if (corner->target_quot[i])
++			corner->target_quot[i] += cpr3_quot_adjustment(
++						corner->ro_scale[i], delta);
++	corner->user_offset_volt = offset;
++
++	rc = cpr3_regulator_update_ctrl_state(ctrl);
++
++	mutex_unlock(&ctrl->lock);
++
++	cpr3_info(vreg, "corner %d offset %d uV: floor %d, ceiling %d, rc=%d\n",
++		  max(*info->index, 0) + 1, offset, corner->floor_volt,
++		  corner->ceiling_volt, rc);
++
++	return rc;
++}
++DEFINE_SIMPLE_ATTRIBUTE_SIGNED(cpr3_debug_corner_offset_fops,
++			cpr3_debug_corner_offset_get,
++			cpr3_debug_corner_offset_set, "%lld\n");
++
+ /**
+  * cpr3_debugfs_create_corner_int - create a debugfs file that is used to read
+  *		a signed int value out of a CPR3 regulator's corner array
+@@ -3880,6 +3952,17 @@
+ 	}
+ 
+ 	info = devm_kzalloc(vreg->thread->ctrl->dev, sizeof(*info), GFP_KERNEL);
++	if (info) {
++		info->vreg = vreg;
++		info->index = index;
++		debugfs_create_file("offset_volt",
++				    index == &vreg->debug_corner ?
++					S_IRUGO | S_IWUSR : S_IRUGO,
++				    corner_dir, info,
++				    &cpr3_debug_corner_offset_fops);
++	}
++
++	info = devm_kzalloc(vreg->thread->ctrl->dev, sizeof(*info), GFP_KERNEL);
+ 	if (!info)
+ 		return;
+ 
