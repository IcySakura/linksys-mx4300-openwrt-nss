+/* Core-to-core (C2C) queue pairing and statistics. */
+#define NSS_C2C_TX_MSG_TYPE_STATS		0
+#define NSS_C2C_TX_MSG_TYPE_TX_MAP		1
+#define NSS_C2C_TX_MSG_TYPE_PERFORMANCE_TEST	2
+
+struct nss_c2c_tx_map {
+	u32 tx_map;
+	u32 c2c_intr_addr;
+};
+
+struct nss_c2c_tx_test {
+	u32 test_id;
+};
+
+struct nss_c2c_tx_msg {
+	struct nss_cmn_msg cm;
+	union {
+		struct nss_c2c_tx_map map;
+		struct nss_c2c_tx_test test;
+		struct nss_cmn_node_stats stats;
+	} msg;
+};
+
+static int nss_c2c_send_map(struct nss_core *src, struct nss_core *dst)
+{
+	struct nss_c2c_tx_msg m = {};
+	int ret;
+
+	m.cm.interface = NSS_INTERFACE_C2C_TX;
+	m.cm.type = NSS_C2C_TX_MSG_TYPE_TX_MAP;
+	m.msg.map.tx_map = dst->c2c_start_dma;
+	m.msg.map.c2c_intr_addr = (u32)dst->nphys_base + NSS_CORE_C2C_INTR_SET;
+
+	ret = nss_msg_send(src, &m, offsetof(struct nss_c2c_tx_msg, msg) +
+				    sizeof(m.msg.map));
+	if (ret)
+		dev_err(src->dev, "C2C map to core %u failed: %d (err %u)\n",
+			dst->id, ret, m.cm.error);
+	else
+		dev_info(src->dev, "C2C paired with core %u (queue %#x intr %#x)\n",
+			 dst->id, m.msg.map.tx_map, m.msg.map.c2c_intr_addr);
+
+	return ret;
+}
+
+static void nss_c2c_try_setup(void)
+{
+	struct nss_core *c0, *c1;
+
+	guard(mutex)(&nss_c2c_lock);
+
+	c0 = nss_core_get(0);
+	c1 = nss_core_get(1);
+	if (!c0 || !c1 || !READ_ONCE(c0->running) || !READ_ONCE(c1->running))
+		return;
+	if (!c0->c2c_start_dma || !c1->c2c_start_dma)
+		return;
+	if (READ_ONCE(c0->c2c_ready) && READ_ONCE(c1->c2c_ready))
+		return;
+
+	if (nss_c2c_send_map(c0, c1) || nss_c2c_send_map(c1, c0))
+		return;
+
+	WRITE_ONCE(c0->c2c_ready, true);
+	WRITE_ONCE(c1->c2c_ready, true);
+}
+
+void nss_c2c_notify(struct nss_core *core, const struct nss_cmn_msg *ncm,
+		    u32 len)
+{
+	u32 iface = NSS_INTERFACE_NUM_GET(ncm->interface);
+	const struct nss_cmn_node_stats *st;
+
+	if (ncm->type != NSS_C2C_TX_MSG_TYPE_STATS ||
+	    len < sizeof(*ncm) + sizeof(*st))
+		return;
+
+	st = (const struct nss_cmn_node_stats *)(ncm + 1);
+	if (iface == NSS_INTERFACE_C2C_TX)
+		core->c2c_tx_pkts += st->tx_packets;
+	else if (iface == NSS_INTERFACE_C2C_RX)
+		core->c2c_rx_pkts += st->rx_packets;
+}
