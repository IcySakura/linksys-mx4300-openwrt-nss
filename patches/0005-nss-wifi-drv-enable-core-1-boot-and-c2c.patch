+static int nss_c2c_show(struct seq_file *s, void *unused)
+{
+	struct nss_core *core = s->private;
+	struct nss_core *peer = nss_core_get(core->id ^ 1);
+
+	seq_printf(s, "core: %u\n", core->id);
+	seq_printf(s, "ready: %u\n", READ_ONCE(core->c2c_ready));
+	seq_printf(s, "queue_dma: %#x\n", core->c2c_start_dma);
+	seq_printf(s, "intr_addr: %#x\n",
+		   (u32)core->nphys_base + NSS_CORE_C2C_INTR_SET);
+	if (peer)
+		seq_printf(s, "peer: core %u running %u queue_dma %#x\n",
+			   peer->id, READ_ONCE(peer->running),
+			   peer->c2c_start_dma);
+	seq_printf(s, "tx_pkts: %llu\n", core->c2c_tx_pkts);
+	seq_printf(s, "rx_pkts: %llu\n", core->c2c_rx_pkts);
+
+	return 0;
+}
+
+static int nss_c2c_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, nss_c2c_show, inode->i_private);
