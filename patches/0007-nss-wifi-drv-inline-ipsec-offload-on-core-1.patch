+static DEFINE_MUTEX(nss_ipsec_lock);
+static struct nss_ipsec_state nss_ipsec = {
+	.inner_if = -1,
+	.mdata_inner_if = -1,
+	.outer_if = -1,
+	.mdata_outer_if = -1,
