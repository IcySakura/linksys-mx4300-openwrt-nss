+	struct net_device __rcu *xfrm_dev;
+	int xfrm_ifindex;
+
+	struct list_head sas;
+	struct list_head outer_rules;
+	struct list_head flows;
+	struct work_struct sync_work;
+
+	/* Firmware and host counters. */
+	u64 inner_tx_pkts;
+	u64 inner_tx_bytes;
+	u64 outer_rx_pkts;
