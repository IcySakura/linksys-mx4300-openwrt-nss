From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Myles Liu <lyx981mike@gmail.com>
Date: Thu, 26 Nov 2026 13:35:20 -0800
Subject: [PATCH 4/4] nss-wifi-drv: add inline IPsec offload on Core 1 via XFRM
 and C2C

---
 .../nss-wifi-drv/files/nss-wifi.flowtable     |   13 +-
 .../kernel/nss-wifi-drv/files/nss-wifi.init   |   11 +
 package/kernel/nss-wifi-drv/src/Makefile      |    6 +-
 package/kernel/nss-wifi-drv/src/nss_core.c    |   34 +-
 package/kernel/nss-wifi-drv/src/nss_flow.c    |   45 +-
 package/kernel/nss-wifi-drv/src/nss_fw.h      |    5 +
 package/kernel/nss-wifi-drv/src/nss_ipsec.c   | 1832 +++++++++++++++++
 package/kernel/nss-wifi-drv/src/nss_ipsec.h   |   41 +
 package/kernel/nss-wifi-drv/src/nss_msg.c     |    9 +-
 package/kernel/nss-wifi-drv/src/nss_ring.c    |    5 +-
 10 files changed, 1986 insertions(+), 15 deletions(-)
 create mode 100644 package/kernel/nss-wifi-drv/src/nss_ipsec.c
 create mode 100644 package/kernel/nss-wifi-drv/src/nss_ipsec.h

diff --git a/package/kernel/nss-wifi-drv/files/nss-wifi.flowtable b/package/kernel/nss-wifi-drv/files/nss-wifi.flowtable
index e5a8dac4ab..b47ac438b9 100644
--- a/package/kernel/nss-wifi-drv/files/nss-wifi.flowtable
+++ b/package/kernel/nss-wifi-drv/files/nss-wifi.flowtable
@@ -20,7 +20,18 @@ esac
 
 for dev in $(ubus call network.interface dump 2>/dev/null |
 	     jsonfilter -e '@.interface[@.up=true].l3_device' | sort -u); do
-	[ "$(cat "/sys/class/net/$dev/type" 2>/dev/null)" = 519 ] || continue
+	type=$(cat "/sys/class/net/$dev/type" 2>/dev/null)
+	case "$type" in
+	519) ;;
+	65534)
+		# Include L3 XFRM tunnel devices (e.g. xfrm0) for Core 1 IPsec offload.
+		grep -qs '^DEVTYPE=xfrm$' "/sys/class/net/$dev/uevent" 2>/dev/null ||
+			ubus call network.interface dump 2>/dev/null |
+			jsonfilter -e '@.interface[@.up=true && @.proto="xfrm"].l3_device' |
+			grep -qx "$dev" || continue
+		;;
+	*) continue ;;
+	esac
 	case "$ft" in
 	*"\"$dev\""*) continue ;;
 	esac
diff --git a/package/kernel/nss-wifi-drv/files/nss-wifi.init b/package/kernel/nss-wifi-drv/files/nss-wifi.init
index 4be37341d6..d159d9e57f 100755
--- a/package/kernel/nss-wifi-drv/files/nss-wifi.init
+++ b/package/kernel/nss-wifi-drv/files/nss-wifi.init
@@ -130,6 +130,17 @@ start_service() {
 		return 0
 	}
 
+	# Opt-in Core 1 bring-up (EIP-197 + inline IPsec offload via C2C).
+	# Never blocks Wi-Fi offload on Core 0 if Core 1 is absent or fails.
+	if [ "$(uci -q get nss-wifi.general.core1)" = "1" ] &&
+	   [ -w /sys/kernel/debug/39400000.nss/boot ]; then
+		if echo 1 > /sys/kernel/debug/39400000.nss/boot 2>/dev/null; then
+			logger -t nss-wifi "core 1 booted (EIP-197 / IPsec offload)"
+		else
+			logger -t nss-wifi "core 1 boot failed, continuing with core 0 only"
+		fi
+	fi
+
 	# Cleared only once the board has been up long enough to have survived
 	# the bring-up, not when the core reports itself started: a hang
 	# arrives after that, and clearing before it turns one bad boot into
diff --git a/package/kernel/nss-wifi-drv/src/Makefile b/package/kernel/nss-wifi-drv/src/Makefile
index 13f156d63d..927fb8e1c1 100644
--- a/package/kernel/nss-wifi-drv/src/Makefile
+++ b/package/kernel/nss-wifi-drv/src/Makefile
@@ -1,8 +1,8 @@
 obj-m += nss-wifi-drv.o
 
-nss-wifi-drv-objs := nss_bridge.o nss_core.o nss_crypto.o nss_flow.o nss_mc.o \
-		     nss_meminfo.o nss_mesh.o nss_msg.o nss_phys.o \
-		     nss_redir.o nss_ring.o nss_wifili.o
+nss-wifi-drv-objs := nss_bridge.o nss_core.o nss_crypto.o nss_flow.o \
+		     nss_ipsec.o nss_mc.o nss_meminfo.o nss_mesh.o nss_msg.o \
+		     nss_phys.o nss_redir.o nss_ring.o nss_wifili.o
 
 ccflags-y += -I$(src)/include
 ccflags-y += -DCONFIG_NSS_WIFI_DRV=1
diff --git a/package/kernel/nss-wifi-drv/src/nss_core.c b/package/kernel/nss-wifi-drv/src/nss_core.c
index 9e258c3025..2c43c466fb 100644
--- a/package/kernel/nss-wifi-drv/src/nss_core.c
+++ b/package/kernel/nss-wifi-drv/src/nss_core.c
@@ -37,6 +37,7 @@
 
 #include "nss_drv.h"
 #include "nss_crypto.h"
+#include "nss_ipsec.h"
 
 /* Core control registers, in the "nphys" range. */
 #define NSS_CORE_RESET_CTRL		0x0004
@@ -483,8 +484,10 @@ static void nss_core_halt(struct nss_core *core)
 	if (peer)
 		WRITE_ONCE(peer->c2c_ready, false);
 
-	if (core->id == 1)
+	if (core->id == 1) {
+		nss_ipsec_stop(core);
 		nss_crypto_stop(core);
+	}
 
 	if (core->id == 0)
 		qca_ppe_fw_carrier_set(core->conduit, NULL);
@@ -1189,8 +1192,8 @@ static void nss_core_restart(struct work_struct *work)
 			ret = nss_core_boot(core);
 	if (!ret && READ_ONCE(core->running)) {
 		nss_c2c_try_setup();
-		if (core->id == 1)
-			nss_crypto_start(core);
+		if (core->id == 1 && !nss_crypto_start(core))
+			nss_ipsec_start(core);
 	}
 	/* After a fault the radios' interfaces are registered with the dead
 	 * instance; after a WLAN reset they are about to register again.
@@ -1242,8 +1245,8 @@ static int nss_boot_set(void *data, u64 val)
 
 	nss_c2c_try_setup();
 
-	if (core->id == 1)
-		nss_crypto_start(core);
+	if (core->id == 1 && !nss_crypto_start(core))
+		nss_ipsec_start(core);
 
 	if (core->id == 0) {
 		nss_phys_arm_ports(core);
@@ -1689,6 +1692,13 @@ static int nss_crypto_show(struct seq_file *s, void *unused)
 }
 DEFINE_SHOW_ATTRIBUTE(nss_crypto);
 
+static int nss_ipsec_show(struct seq_file *s, void *unused)
+{
+	nss_ipsec_print(s);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(nss_ipsec);
+
 static void nss_aux_clocks_put(void *data)
 {
 	struct nss_core *core = data;
@@ -1913,9 +1923,12 @@ static int nss_probe(struct platform_device *pdev)
 	debugfs_create_file("load", 0400, core->debugfs, core, &nss_load_fops);
 	debugfs_create_file("c2c", 0600, core->debugfs, core, &nss_c2c_fops);
 
-	if (core->id == 1)
+	if (core->id == 1) {
 		debugfs_create_file("crypto", 0400, core->debugfs, core,
 				    &nss_crypto_fops);
+		debugfs_create_file("ipsec", 0400, core->debugfs, core,
+				    &nss_ipsec_fops);
+	}
 
 	if (core->id == 0) {
 		debugfs_create_file("wifili_start", 0400, core->debugfs, core,
@@ -2006,12 +2019,18 @@ static int __init nss_module_init(void)
 	if (ret)
 		goto mc;
 
-	ret = platform_driver_register(&nss_driver);
+	ret = nss_ipsec_init();
 	if (ret)
 		goto redir;
 
+	ret = platform_driver_register(&nss_driver);
+	if (ret)
+		goto ipsec;
+
 	return 0;
 
+ipsec:
+	nss_ipsec_exit();
 redir:
 	nss_redir_exit();
 mc:
@@ -2026,6 +2045,7 @@ module_init(nss_module_init);
 static void __exit nss_module_exit(void)
 {
 	platform_driver_unregister(&nss_driver);
+	nss_ipsec_exit();
 	nss_redir_exit();
 	nss_wifili_me_exit();
 	nss_mesh_exit();
diff --git a/package/kernel/nss-wifi-drv/src/nss_flow.c b/package/kernel/nss-wifi-drv/src/nss_flow.c
index e002812f4f..8acd52c230 100644
--- a/package/kernel/nss-wifi-drv/src/nss_flow.c
+++ b/package/kernel/nss-wifi-drv/src/nss_flow.c
@@ -37,6 +37,7 @@
 #include <net/pkt_cls.h>
 
 #include "nss_drv.h"
+#include "nss_ipsec.h"
 
 /* Clamp the priority to the range the egress queues express; a higher value
  * selects no distinct queue. The shipped PPE flow back end bounds the same
@@ -111,6 +112,7 @@ struct nss_flow_entry {
 	bool v6;
 	bool installed;
 	bool bridged;
+	bool ipsec;
 	struct nss_flow_pppoe *pppoe;
 	enum flow_offload_tuple_dir pppoe_dir;	/* the side that is PPPoE */
 	u64 lastused;
@@ -284,6 +286,11 @@ int nss_flow_ifnum(struct nss_core *core, int ifindex, u32 *mtu)
 
 	guard(rcu)();
 
+	/* An offloaded XFRM tunnel routes through Core 1's IPsec inner node. */
+	i = nss_ipsec_ifnum(ifindex, mtu);
+	if (i >= 0)
+		return i;
+
 	/* A mesh device is bound to two nodes; flows go to the one that
 	 * builds the mesh header.
 	 */
@@ -333,7 +340,8 @@ static bool nss_flow_is_wireless(int ifindex)
  */
 bool nss_flow_is_ours(int ifindex)
 {
-	return nss_flow_is_wireless(ifindex) || nss_redir_bound(ifindex);
+	return nss_flow_is_wireless(ifindex) || nss_redir_bound(ifindex) ||
+	       nss_ipsec_owns(ifindex);
 }
 
 /* Everything the firmware is told about one direction, out of that
@@ -432,6 +440,20 @@ static int nss_flow_take_dir(struct nss_core *core, struct nss_flow_entry *e,
 			ether_addr_copy(eth.h_source, out->dev_addr);
 	}
 
+	/* An L3 XFRM device carries no link-layer address; supply a valid
+	 * locally administered placeholder for Core 0's rule check.
+	 */
+	if (!is_valid_ether_addr(eth.h_dest) && out &&
+	    nss_ipsec_owns(out->ifindex)) {
+		static const u8 xfrm_mac[ETH_ALEN] = {
+			0x02, 0x00, 0x00, 0x00, 0x00, 0x01
+		};
+
+		ether_addr_copy(eth.h_dest, xfrm_mac);
+		if (!is_valid_ether_addr(eth.h_source))
+			ether_addr_copy(eth.h_source, xfrm_mac);
+	}
+
 	if (!is_valid_ether_addr(eth.h_dest))
 		return nss_flow_reject_at(NSS_FLOW_REJECT_NO_MAC, -EOPNOTSUPP, f, 0);
 
@@ -890,6 +912,11 @@ static int nss_flow_send_v6(struct nss_core *core, struct nss_flow_entry *e,
 
 static void nss_flow_withdraw(struct nss_core *core, struct nss_flow_entry *e)
 {
+	if (e->ipsec) {
+		nss_ipsec_flow_del(e->flow);
+		e->ipsec = false;
+	}
+
 	if (!e->installed)
 		return;
 
@@ -1033,6 +1060,19 @@ static int nss_flow_replace(struct nss_core *core, struct flow_cls_offload *f)
 		goto drop;
 	}
 
+	if (nss_ipsec_owns(e->dir[FLOW_OFFLOAD_DIR_ORIGINAL].ifindex) ||
+	    nss_ipsec_owns(e->dir[FLOW_OFFLOAD_DIR_REPLY].ifindex)) {
+		ret = nss_ipsec_flow_add(e->flow, flow->ct, e->v6, e->protocol,
+					 e->dir[FLOW_OFFLOAD_DIR_ORIGINAL].ifindex,
+					 e->dir[FLOW_OFFLOAD_DIR_REPLY].ifindex);
+		if (ret) {
+			nss_flow_reject_at(NSS_FLOW_REJECT_FIRMWARE, ret, f,
+					   -ret);
+			goto drop;
+		}
+		e->ipsec = true;
+	}
+
 	ret = e->v6 ? nss_flow_send_v6(core, e, flow->ct, &fw_err) :
 		      nss_flow_send_v4(core, e, flow->ct, &fw_err);
 	if (ret) {
@@ -1452,7 +1492,8 @@ static int nss_flow_indr_cb(struct net_device *dev, struct Qdisc *sch,
 			    void *type_data, void *data,
 			    void (*cleanup)(struct flow_block_cb *block_cb))
 {
-	if (!dev || type != TC_SETUP_FT || dev->type != ARPHRD_RAWIP)
+	if (!dev || type != TC_SETUP_FT ||
+	    (dev->type != ARPHRD_RAWIP && !nss_ipsec_is_xfrm_dev(dev)))
 		return -EOPNOTSUPP;
 
 	return nss_flow_block(dev, type_data, sch, data, cleanup);
