+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Inline IPsec offload on NSS Core 1 (nss_ipsec_cmn + EIP-197 + C2C). */
+
+#ifndef __NSS_IPSEC_H
+#define __NSS_IPSEC_H
+
+#include <linux/netdevice.h>
+#include <linux/seq_file.h>
+#include <linux/skbuff.h>
+#include <linux/types.h>
+
+struct nss_core;
+struct nss_cmn_msg;
+struct n2h_descriptor;
+struct nf_conn;
+struct napi_struct;
+
+/* MTU advertised to Core 0 for the IPsec inner interface so Core 0 hands full
+ * inner packets to Core 1 without pre-fragmentation.
+ */
+#define NSS_IPSEC_INNER_MTU	9000
+
+int nss_ipsec_init(void);
+void nss_ipsec_exit(void);
+int nss_ipsec_start(struct nss_core *core);
+void nss_ipsec_stop(struct nss_core *core);
+void nss_ipsec_notify(struct nss_core *core, const struct nss_cmn_msg *ncm,
+		      u32 len);
+bool nss_ipsec_recv(struct nss_core *core, struct napi_struct *napi,
+		    const struct n2h_descriptor *desc, struct sk_buff *skb);
+
+/* Hooks used by nss_flow.c for XFRM interface flowtable offload. */
+bool nss_ipsec_is_xfrm_dev(const struct net_device *dev);
+bool nss_ipsec_owns(int ifindex);
+int nss_ipsec_ifnum(int ifindex, u32 *mtu);
+int nss_ipsec_flow_add(unsigned long key, struct nf_conn *ct, bool v6,
+		       u8 protocol, int orig_ifindex, int reply_ifindex);
+void nss_ipsec_flow_del(unsigned long key);
+void nss_ipsec_print(struct seq_file *s);
+
+#endif /* __NSS_IPSEC_H */
diff --git a/package/kernel/nss-wifi-drv/src/nss_msg.c b/package/kernel/nss-wifi-drv/src/nss_msg.c
index bc3aab2aec..2eb38b6697 100644
