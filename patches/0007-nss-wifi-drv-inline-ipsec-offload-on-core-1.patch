+/* Snapshot captured under xfrm_state_walk spinlock and processed outside it. */
+struct nss_ipsec_sa_spec {
+	struct nss_ipsec_cmn_sa_tuple tuple;
+	struct nss_ipsec_cmn_sa_data data;
+	enum nss_crypto_algo algo;
+	u8 cipher_key[NSS_CRYPTO_CIPHER_KEYLEN_MAX];
+	u16 cipher_keylen;
+	u8 auth_key[NSS_CRYPTO_AUTH_KEYLEN_MAX];
+	u16 auth_keylen;
+	u8 nonce[NSS_CRYPTO_NONCE_SIZE_MAX];
+	u16 nonce_len;
+	u32 if_id;
+	bool decap;
+};
