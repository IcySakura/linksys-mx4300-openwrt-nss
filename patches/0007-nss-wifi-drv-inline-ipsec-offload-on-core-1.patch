+struct nss_ipsec_sa {
+	struct list_head node;
+	struct rcu_head rcu;
+	struct nss_ipsec_cmn_sa_tuple tuple;
+	struct nss_ipsec_cmn_sa_data data;
+	struct nss_ipsec_outer_rule *outer;
+	u32 if_id;
+	u16 crypto_idx;
+	bool decap;
+	bool seen;
+};
