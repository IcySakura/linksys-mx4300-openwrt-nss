 	NSS_DYNAMIC_INTERFACE_TYPE_WIFI_MESH_INNER = 70,
diff --git a/package/kernel/nss-wifi-drv/src/nss_ipsec.c b/package/kernel/nss-wifi-drv/src/nss_ipsec.c
new file mode 100644
index 0000000000..eff237b99b
--- /dev/null
+++ b/package/kernel/nss-wifi-drv/src/nss_ipsec.c
@@ -0,0 +1,1832 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Inline IPsec offload on NSS Core 1 (nss_ipsec_cmn + EIP-197 + C2C).
+ *
+ * Bridges mainline Linux XFRM (via xfrm_register_km + xfrm_state_walk, zero
+ * kernel patches) to Core 1's nss_ipsec_cmn firmware node and Core 0's flow
+ * tables:
+ *   - Core 1 owns 100% of ESP sequence numbers and anti-replay windows for
+ *     offloaded tunnel-mode SAs (using mdata_inner lookaside for host /
+ *     first-packet outbound traffic and inline inner/outer nodes via C2C for
+ *     forwarded flows).
+ *   - Decrypted inner exceptions from Core 1 arrive on inner_if and are
+ *     injected into the bound xfrm netdev via netif_receive_skb().
+ *   - Inbound IKEv2 non-ESP exceptions (UDP-4500 SPI==0) on outer_if are
+ *     injected into the local WAN netdev; outbound encrypted exceptions are
+ *     routed via ip_local_out() / ip6_local_out().
+ *   - If Core 1 is halted or ipsec=0, all hooks are inactive and Linux's
+ *     native software XFRM (ARMv8 AES-CE) handles traffic transparently.
+ */
+
+#include <linux/cleanup.h>
+#include <linux/etherdevice.h>
+#include <linux/if_arp.h>
+#include <linux/in.h>
+#include <linux/in6.h>
+#include <linux/inetdevice.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/netdevice.h>
+#include <linux/netfilter.h>
+#include <linux/netfilter_ipv4.h>
+#include <linux/netfilter_ipv6.h>
+#include <linux/rcupdate.h>
+#include <linux/rtnetlink.h>
+#include <linux/seq_file.h>
+#include <linux/skbuff.h>
+#include <linux/udp.h>
+#include <linux/workqueue.h>
+#include <net/addrconf.h>
+#include <net/dst.h>
+#include <net/esp.h>
+#include <net/ip.h>
+#include <net/ip6_route.h>
+#include <net/neighbour.h>
+#include <net/netfilter/nf_conntrack.h>
+#include <net/route.h>
+#include <net/rtnetlink.h>
+#include <net/xfrm.h>
+
+#include "nss_drv.h"
+#include "nss_crypto.h"
+#include "nss_ipsec.h"
+
+static bool nss_ipsec_enable = true;
+module_param_named(ipsec, nss_ipsec_enable, bool, 0644);
+MODULE_PARM_DESC(ipsec, "enable inline IPsec offload on NSS Core 1");
+
+bool nss_ipsec_is_xfrm_dev(const struct net_device *dev)
+{
+	return dev && dev->type == ARPHRD_NONE && dev->rtnl_link_ops &&
+	       dev->rtnl_link_ops->kind &&
+	       !strcmp(dev->rtnl_link_ops->kind, "xfrm");
+}
+
+#if IS_ENABLED(CONFIG_XFRM)
+
+/* nss_ipsec_cmn wire protocol (matches firmware 12.5 nss_ipsec_cmn.h). */
+#define NSS_IPSEC_CMN_FLAG_IPV6		BIT(0)
+#define NSS_IPSEC_CMN_FLAG_IPV4_NATT	BIT(1)
+#define NSS_IPSEC_CMN_FLAG_ESP_ESN	BIT(3)
+#define NSS_IPSEC_CMN_FLAG_ESP_REPLAY	BIT(5)
+#define NSS_IPSEC_CMN_FLAG_CIPHER_GCM	BIT(7)
+#define NSS_IPSEC_CMN_FLAG_COPY_DSCP	BIT(8)
+#define NSS_IPSEC_CMN_FLAG_COPY_DF	BIT(9)
+
+#define NSS_IPSEC_CMN_MDATA_VERSION	0x01
+#define NSS_IPSEC_CMN_MDATA_MAGIC	0x8893
+#define NSS_IPSEC_CMN_MDATA_ORIGIN_HOST	0x01
+
+#define NSS_IPSEC_TX_HEADROOM		192
+#define NSS_IPSEC_TX_TAILROOM		128
+#define NSS_IPSEC_MAX_SA		64
+
+enum nss_ipsec_cmn_msg_type {
+	NSS_IPSEC_CMN_MSG_NODE_CONFIG	= 1,
+	NSS_IPSEC_CMN_MSG_CTX_CONFIG	= 2,
+	NSS_IPSEC_CMN_MSG_CTX_SYNC	= 3,
+	NSS_IPSEC_CMN_MSG_SA_CREATE	= 4,
+	NSS_IPSEC_CMN_MSG_SA_DESTROY	= 5,
+	NSS_IPSEC_CMN_MSG_SA_SYNC	= 6,
+	NSS_IPSEC_CMN_MSG_FLOW_CREATE	= 7,
+	NSS_IPSEC_CMN_MSG_FLOW_DESTROY	= 8,
+};
+
+enum nss_ipsec_cmn_ctx_type {
+	NSS_IPSEC_CMN_CTX_INNER		= 1,
+	NSS_IPSEC_CMN_CTX_MDATA_INNER	= 2,
+	NSS_IPSEC_CMN_CTX_OUTER		= 3,
+	NSS_IPSEC_CMN_CTX_MDATA_OUTER	= 4,
+};
+
+struct nss_ipsec_cmn_flow_tuple {
+	u32 dest_ip[4];
+	u32 src_ip[4];
+	u32 spi_index;
+	u16 dst_port;
+	u16 src_port;
+	u8 user_pattern;
+	u8 protocol;
+	u8 ip_ver;
+};
+
+struct nss_ipsec_cmn_sa_tuple {
+	u32 dest_ip[4];
+	u32 src_ip[4];
+	u32 spi_index;
+	u16 dest_port;
+	u16 src_port;
+	u16 crypto_index;
+	u8 protocol;
+	u8 ip_ver;
+	u8 hop_limit;
+	u8 res[3];
+};
+
+struct nss_ipsec_cmn_sa_data {
+	u32 seq_start;
+	u32 flags;
+	u16 window_size;
+	u8 dscp;
+	u8 df;
+	u8 blk_len;
+	u8 iv_len;
+	u8 icv_len;
+	u8 res1;
+	u32 res2[4];
+};
+
+struct nss_ipsec_cmn_flow {
+	struct nss_ipsec_cmn_flow_tuple flow_tuple;
+	struct nss_ipsec_cmn_sa_tuple sa_tuple;
+};
+
+struct nss_ipsec_cmn_sa {
+	struct nss_ipsec_cmn_sa_tuple sa_tuple;
+	struct nss_ipsec_cmn_sa_data sa_data;
+};
+
+struct nss_ipsec_cmn_ctx {
+	u32 type;
+	u32 except_ifnum;
+	u32 sibling_ifnum;
+};
+
+struct nss_ipsec_cmn_node {
+	u8 dma_redirect;
+	u8 dma_lookaside;
+	u16 max_sa;
+};
+
+struct nss_ipsec_cmn_ctx_stats {
+	struct nss_cmn_node_stats cmn_stats;
+	u32 exceptioned;
+	u32 linearized;
+	u32 redirected;
+	u32 dropped;
+	u32 fail_sa;
+	u32 fail_flow;
+	u32 fail_stats;
+	u32 fail_exception;
+	u32 fail_transform;
+	u32 fail_linearized;
+	u32 fail_mdata_ver;
+	u32 fail_ctx_active;
+	u32 fail_pbuf_crypto;
+	u32 fail_queue_crypto;
+};
+
+struct nss_ipsec_cmn_ctx_sync {
+	u32 type;
+	struct nss_ipsec_cmn_ctx_stats stats;
+};
+
+struct nss_ipsec_cmn_msg {
+	struct nss_cmn_msg cm;
+	union {
+		struct nss_ipsec_cmn_node node;
+		struct nss_ipsec_cmn_ctx ctx;
+		struct nss_ipsec_cmn_sa sa;
+		struct nss_ipsec_cmn_flow flow;
+		struct nss_ipsec_cmn_ctx_sync ctx_sync;
+	} msg;
+};
+
+struct nss_ipsec_cmn_mdata_cmn {
+	u8 version;
+	u8 origin;
+	u16 len;
+	u8 res[2];
+	u16 magic;
+};
+
+struct nss_ipsec_cmn_mdata_encap {
+	struct nss_ipsec_cmn_sa_tuple sa;
+	u32 seq_num;
+	u16 data_len;
+	u16 flags;
+};
+
+struct nss_ipsec_cmn_mdata {
+	struct nss_ipsec_cmn_mdata_cmn cm;
+	struct nss_ipsec_cmn_mdata_encap encap;
+};
+
+struct nss_ipsec_outer_rule {
+	struct list_head node;
+	u8 ip_ver;
+	u8 protocol;
+	u16 local_port;
+	u16 remote_port;
+	u32 local_ip[4];
+	u32 remote_ip[4];
+	u32 ref;
+	bool installed;
+};
