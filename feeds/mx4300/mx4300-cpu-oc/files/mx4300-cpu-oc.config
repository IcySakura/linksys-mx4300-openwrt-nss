# CPU overclocking for the Linksys MX4300 - see System -> CPU Overclock in
# LuCI, or "mx4300-cpu-oc" on the command line. Off unless enabled here.
#
#   enabled          '1' to allow speeds above the stock 1382.4 MHz
#   max_freq         highest speed in kHz (see "mx4300-cpu-oc status" for
#                    the speeds this firmware offers)
#   disabled_reason  set when overclocking was turned off automatically
#                    (a crash while overclocked, or a failed stability test)

config cpu-oc 'main'
	option enabled '0'
	option max_freq '1843200'
