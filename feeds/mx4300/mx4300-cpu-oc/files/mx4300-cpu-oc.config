# CPU overclocking for the Linksys MX4300 - see System -> CPU Overclock in
# LuCI, or "mx4300-cpu-oc" on the command line. Off unless enabled here.
#
#   enabled          '1' to allow speeds above the stock 1382.4 MHz
#   mode             'simple' (a preset, automatic voltages) or 'advanced'
#   preset           simple mode: 'balanced' (1843.2 MHz) or 'performance'
#                    (2208 MHz)
#   max_freq         advanced mode: highest speed in kHz
#   extreme          advanced mode: '1' allows speeds above 2208 MHz
#   volt_cap         advanced mode: no voltage level above 'family' (944 mV,
#                    the default: this chip family's normal top voltage),
#                    'chip' (776 mV: this router's stock maximum) or 'none'
#                    (the 1064 mV hard limit)
#   offset_1..6      advanced mode: voltage offset in uV for each voltage
#                    level (1: 1017.6, 2: 1382.4, 3: 1497.6-1651.2,
#                    4: 1843.2, 5: 1920, 6: 2073.6 MHz and above)
#   last_good        set automatically: the last settings that passed a
#                    stability test (a crash reverts to them)
#   disabled_reason  set when overclocking was changed automatically

config cpu-oc 'main'
	option enabled '0'
	option mode 'simple'
	option preset 'performance'
	option max_freq '2208000'
	option extreme '0'
	option volt_cap 'family'
