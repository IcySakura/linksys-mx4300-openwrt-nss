// Temperatures for LuCI's Dashboard and Status -> Overview: the kernel's
// thermal zones (SoC, NSS cores, Wi-Fi blocks) and the ath11k radios' own
// sensors, read in one call.

'use strict';

import { glob, readfile, readlink } from 'fs';

function celsius(path) {
	const raw = trim(readfile(path) ?? '');

	return match(raw, /^-?[0-9]+$/) ? +raw / 1000 : null;
}

function zones() {
	const out = [];

	for (let dir in glob('/sys/class/thermal/thermal_zone*')) {
		const name = trim(readfile(`${dir}/type`) ?? '');
		const temp = celsius(`${dir}/temp`);
		let passive = null, critical = null;

		if (!length(name) || temp == null)
			continue;

		for (let tp in glob(`${dir}/trip_point_*_type`)) {
			const kind = trim(readfile(tp) ?? '');
			const limit = celsius(replace(tp, /_type$/, '_temp'));

			if (limit == null)
				continue;
			if (kind == 'passive' && (passive == null || limit < passive))
				passive = limit;
			else if (kind == 'critical' && (critical == null || limit < critical))
				critical = limit;
		}

		push(out, { name: replace(name, /[-_]thermal$/, ''), temp, passive, critical });
	}

	return out;
}

function radios() {
	const out = [];

	for (let dir in glob('/sys/class/hwmon/hwmon*')) {
		const temp = celsius(`${dir}/temp1_input`);
		const phy = match(readlink(`${dir}/device`) ?? '', /(phy[0-9]+)$/);

		if (trim(readfile(`${dir}/name`) ?? '') == 'ath11k_hwmon' && temp != null && phy)
			push(out, { name: phy[1], temp, passive: null, critical: null });
	}

	return out;
}

return {
	'luci.thermal': {
		get: {
			call: function() {
				return { zones: zones(), radios: radios() };
			}
		}
	}
};
