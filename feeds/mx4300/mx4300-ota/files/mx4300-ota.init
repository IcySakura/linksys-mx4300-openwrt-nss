#!/bin/sh /etc/rc.common
# Holds the boot counter reset for firmware installed by "mx4300-ota upgrade"
# (the bootcount service at S99 resets it unless held), and records a rollback
# when the previous firmware comes back.

START=98
USE_PROCD=1

start_service() {
	local trial part

	trial=$(fw_printenv -n mx4300_ota_trial 2>/dev/null)
	[ -n "$trial" ] || return 0

	part=$(/usr/sbin/mx4300-ota status | jsonfilter -e @.slot)
	if [ "${trial##* }" = "$part" ]; then
		touch /var/run/bootcount.hold
		procd_open_instance
		procd_set_param command /usr/sbin/mx4300-ota watch
		procd_close_instance
	else
		# The marker names the other partition: the update did not stick and
		# this, the previous firmware, is running again.
		mkdir -p /etc/mx4300-ota
		echo "Update to ${trial% *} was rolled back on $(date)" > /etc/mx4300-ota/last-result
		printf '%s\trolled-back\t%s\t%s\n' "$(date +%s)" "${trial% *}" \
			"Update to ${trial% *} did not stick; back on the previous firmware" >> /etc/mx4300-ota/history
		logger -t mx4300-ota "update to ${trial% *} was rolled back"
		fw_setenv mx4300_ota_trial
	fi
}
