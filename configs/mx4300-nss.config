# Linksys MX4300 with PPE + NSS offload - diffconfig, expanded by "make defconfig".
# Package selections beyond this base belong in profiles/*.packages.
#
# Follows the build config of JuliusBairaktaris/Qualcommax_NSS_Builder
# (devices/common/config), the images the upstream tree is tested with.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_linksys_mx4300=y
# Sysupgrade images only: the first install is a sysupgrade from stock OpenWrt
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# Toolchain
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_15=y
CONFIG_BINUTILS_USE_VERSION_2_46=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53"
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_MOLD=y
CONFIG_BUILD_PATENTED=y

# Hardening
CONFIG_GCC_DEFAULT_PIE=y
CONFIG_GCC_DEFAULT_SSP=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_ALL=y
CONFIG_PKG_CC_STACKPROTECTOR_ALL=y
CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG=y
CONFIG_PKG_FORTIFY_SOURCE_3=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_USE_SECCOMP=y

# OpenSSL throughout (apk, uclient-fetch, LuCI over HTTPS, wpad)
CONFIG_PACKAGE_apk-mbedtls=n
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_PACKAGE_libustream-mbedtls=n
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y

# Wired offload in the PPE through the kernel's own interfaces: routed and
# NAT flows from the fw4 flowtable (flow_offloading_hw, set on first boot by
# the target), bridging and multicast snooping through switchdev, SQM through
# tc qdisc offload (sqm-scripts' hw_ppe.qos, see patches/feeds/packages/).
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_qca-ppe-qos=y
CONFIG_PACKAGE_luci-app-qca-ppe-qos=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-prio=y
CONFIG_PACKAGE_kmod-sched-act-police=y
CONFIG_PACKAGE_kmod-sched-act-pedit=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
CONFIG_PACKAGE_kmod-sched-mqprio=y
CONFIG_PACKAGE_kmod-sched-ets=y
CONFIG_PACKAGE_kmod-sched-red=y
CONFIG_PACKAGE_kmod-sched-gred=y
CONFIG_PACKAGE_dcb=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_devlink=y
CONFIG_KERNEL_DCB=y
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE=y

# Wi-Fi offload: nss-wifi-drv boots the NSS firmware and takes the ath11k
# data path. Off with: uci set nss-wifi.general.offload=0; uci commit; reboot
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y

# Kernel modules cannot come from the official feeds (the kernel differs), so
# the common ones are built in; add others in a profile.
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y

# Crash forensics (ramoops) and the offload diagnostics report (ppe-help)
CONFIG_PACKAGE_kmod-ramoops=y
CONFIG_PACKAGE_ppe-help=y

# Attended sysupgrade would install official builds without NSS
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_attendedsysupgrade-common=n
